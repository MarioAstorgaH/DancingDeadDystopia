vertical_alignment = 2

[node name="hint_label" type="Label" parent="Control/calibration_margin/calibration_container"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2
text = "TOCA EL CEREBRO CADA VEZ QUE ESCUCHES EL GOLPE"
label_settings = SubResource("LabelSettings_row")
horizontal_alignment = 1
vertical_alignment = 2
autowrap_mode = 2

[node name="tap_button" type="TextureButton" parent="Control/calibration_margin/calibration_container"]
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
texture_normal = ExtResource("7_brain")
texture_pressed = ExtResource("8_brain_pressed")
ignore_texture_size = true
stretch_mode = 5

[node name="status_label" type="Label" parent="Control/calibration_margin/calibration_container"]
unique_name_in_owner = true
layout_mode = 2
text = "TOQUES 0 / 4"
label_settings = SubResource("LabelSettings_row")
horizontal_alignment = 1

[node name="latency_row" type="VBoxContainer" parent="Control/calibration_margin/calibration_container"]
layout_mode = 2

[node name="name_label" type="Label" parent="Control/calibration_margin/calibration_container/latency_row"]
layout_mode = 2
text = "LATENCIA"
label_settings = SubResource("LabelSettings_row")

[node name="controls" type="HBoxContainer" parent="Control/calibration_margin/calibration_container/latency_row"]
layout_mode = 2
theme_override_constants/separation = 30

[node name="latency_slider" type="HSlider" parent="Control/calibration_margin/calibration_container/latency_row/controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_styles/slider = SubResource("StyleBoxFlat_track")
theme_override_styles/grabber_area = SubResource("StyleBoxFlat_fill")
theme_override_styles/grabber_area_highlight = SubResource("StyleBoxFlat_fill")
theme_override_icons/grabber = SubResource("GradientTexture2D_grabber")
theme_override_icons/grabber_highlight = SubResource("GradientTexture2D_grabber_hl")
min_value = -100.0
max_value = 400.0
step = 5.0

[node name="latency_value" type="Label" parent="Control/calibration_margin/calibration_container/latency_row/controls"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
text = "0 MS"
label_settings = SubResource("LabelSettings_row")
horizontal_alignment = 2
vertical_alignment = 1

[node name="back_button" type="Button" parent="Control/calibration_margin/calibration_container"]
custom_minimum_size = Vector2(400, 120)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("1_font")
theme_override_font_sizes/font_size = 50
theme_override_styles/normal = ExtResource("4_normal")
theme_override_styles/pressed = ExtResource("5_press")
theme_override_styles/hover = ExtResource("6_hover")
text = "VOLVER"
language = "es_MX"

[node name="calibration_player" type="AudioStreamPlayer" parent="Control/calibration_margin/calibration_container"]
unique_name_in_owner = true
bus = &"GameMusic"
script = ExtResource("3_player")

[connection signal="button_down" from="Control/calibration_margin/calibration_container/tap_button" to="Control/calibration_margin/calibration_container" method="_on_tap_button_down"]
[connection signal="value_changed" from="Control/calibration_margin/calibration_container/latency_row/controls/latency_slider" to="Control/calibration_margin/calibration_container" method="_on_latency_slider_value_changed"]
[connection signal="finished" from="Control/calibration_margin/calibration_container/calibration_player" to="Control/calibration_margin/calibration_container" method="_on_calibration_player_finished"]
[connection signal="pressed" from="Control/calibration_margin/calibration_container/back_button" to="Control/calibration_margin/calibration_container" method="_on_back_button_pressed"]
