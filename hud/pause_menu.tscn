[connection signal="pressed" from="center/menu/resume_button" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="center/menu/retry_button" to="." method="_on_retry_button_pressed"]
[connection signal="pressed" from="center/menu/quit_button" to="." method="_on_quit_button_pressed"]
